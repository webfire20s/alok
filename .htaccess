RewriteEngine On

RewriteBase /

# CATEGORY

RewriteRule ^category/([^/]+)/?$ category.php?slug=$1 [L,QSA]

# PRODUCT

RewriteRule ^product/([^/]+)/?$ product.php?slug=$1 [L,QSA]

# STATIC PAGES

RewriteRule ^cart/?$ cart.php [L,QSA]

RewriteRule ^checkout/?$ checkout.php [L,QSA]

RewriteRule ^login/?$ login.php [L,QSA]

RewriteRule ^register/?$ register.php [L,QSA]

RewriteRule ^my-account/?$ my-account.php [L,QSA]

RewriteRule ^contact/?$ contact.php [L,QSA]

RewriteRule ^blogs/?$ blogs.php [L,QSA]

RewriteRule ^bulk-inquiry/?$ bulk_inquiry.php [L,QSA]

RewriteRule ^decoration-services/?$ decoration-services.php [L,QSA]

RewriteRule ^gallery/?$ gallery.php [L,QSA]

RewriteRule ^infrastructure/?$ infrastructure.php [L,QSA]

# CMS PAGES (KEEP LAST)

RewriteRule ^([a-zA-Z0-9-]+)/?$ page.php?slug=$1 [L,QSA]